{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miamicreme/Empire-Voice-Module/contracts/memory-event.schema.json",
  "title": "Empire Voice Memory Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_id",
    "source_voice_intent_id",
    "memory_type",
    "summary",
    "sensitivity",
    "redaction_status",
    "retention",
    "reason_to_remember"
  ],
  "properties": {
    "memory_id": { "type": "string", "minLength": 1 },
    "source_voice_intent_id": { "type": "string", "minLength": 1 },
    "memory_type": {
      "type": "string",
      "enum": ["preference", "goal", "commitment", "decision", "personal_fact", "client_note", "deal_note", "project_note", "do_not_store"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "sensitivity": {
      "type": "string",
      "enum": ["ephemeral", "private_memory", "public_safe", "secret"]
    },
    "redaction_status": {
      "type": "string",
      "enum": ["not_needed", "redacted", "blocked"]
    },
    "retention": {
      "type": "string",
      "enum": ["none", "session", "30d", "90d", "long_term"]
    },
    "reason_to_remember": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
