{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miamicreme/Empire-Voice-Module/contracts/empireos-command.schema.json",
  "title": "EmpireOS Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "source_voice_intent_id",
    "command_type",
    "priority",
    "mission_area",
    "next_best_action",
    "time_horizon",
    "risk_level",
    "confidence",
    "permission_status"
  ],
  "properties": {
    "command_id": { "type": "string", "minLength": 1 },
    "source_voice_intent_id": { "type": "string", "minLength": 1 },
    "command_type": {
      "type": "string",
      "enum": ["daily_priority", "mission_create", "task_create", "decision_support", "client_prep", "deal_action", "repo_action", "memory_save", "watch_item"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "urgent"]
    },
    "mission_area": { "type": "string", "minLength": 1 },
    "next_best_action": { "type": "string", "minLength": 1 },
    "time_horizon": {
      "type": "string",
      "enum": ["now", "today", "this_week", "this_month", "later"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "target_module": {
      "type": "string",
      "enum": ["empireos", "skillforge", "dealflow", "globalintel", "signalbrief", "framebrief", "mcp", "manual"]
    },
    "permission_status": {
      "type": "string",
      "enum": ["not_required", "required", "granted", "denied"]
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
